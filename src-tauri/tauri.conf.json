{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GBF POWER REBORN",
  "version": "0.3.0",
  "identifier": "cc.lzsony.gbf-power-reborn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GBF POWER REBORN",
        "width": 400,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "backgroundColor": "#171b20",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../docs/OFL-NotoSansTC.txt": "licenses/OFL-NotoSansTC.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../LICENSE": "licenses/LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
