IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
// Match the device and Apple Silicon simulator slices shipped in GPRCore.xcframework.
ARCHS = arm64
SUPPORTS_MACCATALYST = NO
GPR_BUNDLE_ID = cc.lzsony.gpr.ios
GPR_APP_GROUP = group.cc.lzsony.gpr.ios
MARKETING_VERSION = 0.5.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
SWIFT_OBJC_BRIDGING_HEADER = $(PROJECT_DIR)/Shared/GPRCore.h
OTHER_LDFLAGS = $(inherited) -lsqlite3 -lz -framework Security -framework SystemConfiguration
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
GENERATE_INFOPLIST_FILE = NO
DEAD_CODE_STRIPPING = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
#include? "Local.xcconfig"
